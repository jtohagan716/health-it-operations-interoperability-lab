{
    "Name": "InteropLabOrthanc",
    "DicomAet": "ORTHANC",
    "DicomPort": 4242,
    "HttpPort": 8042,
    "AuthenticationEnabled": false,
    "RemoteAccessAllowed": true,
    "DicomServerEnabled": true,
    "LuaScripts": [
        "/etc/orthanc/lua/autoroute.lua"
    ],
    "DicomModalities": {
        "interoplab": [
            "INTEROPLAB",
            "dicom-storage-scp",
            11112
        ],
        "unavailable": [
            "UNAVAILABLE",
            "host.docker.internal",
            11113
        ],
        "ct_modality": [
            "CT_MODALITY",
            "host.docker.internal",
            11114
        ],
        "xray_modality": [
            "XRAY_MODALITY",
            "host.docker.internal",
            11115
        ]
    },
    "Worklists": {
        "Enable": true,
        "FilterIssuerAet": false,
        "LimitAnswers": 100,
        "SaveInOrthancDatabase": true,
        "SetStudyInstanceUidIfMissing": true,
        "DeleteWorklistsOnStableStudy": false,
        "DeleteWorklistsDelay": 0
    },
    "StorageDirectory": "/var/lib/orthanc/db",
    "KeepAlive": true,
    "StableAge": 5,
    "LogExportedResources": true
}